# ── LLM API keys ─────────────────────────────────────────────────────────────
# Residents whose provider has no key fall back to a scripted "offline" brain,
# so the house still runs — but they'll be noticeably dumber. Add real keys here.

# Hugging Face Inference Providers (provider: "huggingface")
# Create a token at https://huggingface.co/settings/tokens with
# “Make calls to the Inference Providers” enabled.
HF_TOKEN=

# OpenAI (provider: "openai") — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (provider: "anthropic") — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Any OpenAI-compatible server (provider: "openai-compatible"), e.g.
#   OpenRouter  → OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
#   Groq        → OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
#   Ollama      → OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1  (key can be anything)
#   Azure AI Foundry / LM Studio / vLLM also work.
# A resident can override these with its own "baseUrl" / "apiKeyEnv" in config/house.json.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
